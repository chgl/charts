{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeStableNonMajor",
    ":automergeDigest"
  ],
  "gitIgnoredAuthors": ["github-actions"],
  "postUpgradeTasks": {
    "executionMode": "branch",
    "commands": [
      ".github/renovate-post-upgrade.sh \"{{depName}}\" \"{{newVersion}}\" \"{{newDigest}}\" \"{{depType}}\" \"{{currentVersion}}\""
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update kube-powertools container image",
      "managerFilePatterns": [
        "/README.md$/",
        "/.github/workflows/ci.yaml/",
        "/.github/workflows/release.yaml/"
      ],
      "matchStrings": [
        "(?<depName>ghcr.io\\/chgl\\/kube-powertools):(?<currentValue>[a-z0-9.-]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Keep Chart.yaml appVersion in sync with the chart's main container image",
      "managerFilePatterns": ["/(^|/)Chart\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*image=(?<depName>\\S+)\\s+appVersion:\\s*[\"']?(?<currentValue>[^\\s\"'@]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Keep the Kubernetes versions of the kind cluster test matrix up-to-date",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*k8s-version=(?<depType>k8s-(?:oldest|middle|newest))\\s*\\n\\s*-\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kindest/node",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ],
  "packageRules": [
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "extends": ["schedule:monthly"]
    },
    {
      "matchManagers": ["helmv3"],
      "pinDigests": false
    },
    {
      "description": "appVersion is a plain version, never pin it to a digest",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/Chart.yaml"],
      "pinDigests": false
    },
    {
      "matchDatasources": ["docker", "helm"],
      "matchDepNames": ["postgres", "docker.io/library/postgresql", "minio"],
      "extends": ["schedule:monthly"]
    },
    {
      "matchPackageNames": ["/docker\\.io\\/ohdsi\\/.*/"],
      "groupName": "ohdsi"
    },
    {
      "description": "kind test matrix: no digests, separate patch updates, and one branch per matrix entry so the rotation in renovate-post-upgrade.sh sees the newest version's update on its own",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["kindest/node"],
      "pinDigests": false,
      "separateMinorPatch": true,
      "additionalBranchPrefix": "{{depType}}-",
      "commitMessageTopic": "kind test matrix {{depType}} Kubernetes version"
    },
    {
      "description": "kind test matrix: only patch updates for the older Kubernetes versions, the newest one rotates the list on a minor update",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["kindest/node"],
      "matchDepTypes": ["k8s-oldest", "k8s-middle"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "kind test matrix: never jump to a new major version",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["kindest/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
